# MimirAether — copy to .env and fill in (never commit real secrets).
# See docs/MIMIR_RUNTIME_CONTRACT.md and docs/GATEWAY_SYSTEMD_ENV.md

# Project root (optional if you always use scripts/start.sh from this repo)
# MIMIR_AETHER_HOME=/path/to/MimirAether
# HERMES_HOME=/path/to/MimirAether

# LLM (examples — names depend on provider)
DEEPSEEK_API_KEY=YOUR_API_KEY_HERE
# DEEPSEEK_API_KEYS=key1,key2
TAVILY_API_KEY=

# Runtime
DEFAULT_MODEL=deepseek/deepseek-chat
MAX_ITERATIONS=30
GATEWAY_PORT=18789

# Optional: extra skill roots (colon-separated), see agent/prompt_builder
# EXTRA_SKILLS_DIRS=/path/to/extra/skills

# IQ-EVO: post-close LLM analysis (fire-and-forget; writes data/analysis_artifacts/)
# Production rollout: docs/ops/MIMIR_AUTO_ANALYSIS_ROLLOUT.md — requires Gateway restart
# MIMIR_AUTO_ANALYSIS=1
# Do NOT enable without separate approval (auto-writes skills):
# MIMIR_AUTO_EVOLVE=1

# Observability (OBS-B1-02) — see docs/ops/MIMIR_OPS_PANEL.md
# MIMIR_MONITOR_ERROR_RATE_THRESHOLD=0.10
# MIMIR_MONITOR_WINDOW_SECONDS=300
# MIMIR_TRUNCATE_SINCE_START_MAX=10
