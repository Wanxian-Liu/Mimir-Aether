# MimirAether environment template — copy to ~/.mimiraether/.env and fill in
# All paths are optional; defaults are sensible for standard installs.

# Runtime home (data root: config, memory, sessions, logs)
# MIMIR_AETHER_HOME=~/.mimiraether

# Wiki/knowledge base root (for cross-referencing notes, optional)
# MIMIR_WIKI_ROOT=~/wiki

# LLM provider (see config.yaml for full settings)
# DEEPSEEK_API_KEY=sk-...
