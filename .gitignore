.env

__pycache__/
.pytest_cache/
*.py[cod]

# 本地模型缓存（体积大、易变；由 agent/models_dev.py 写入；勿入库）
models_dev_cache.json

# 仓库根：本机配置与运行态（path-contract：与 ~/.openclaw 并列时也不混进 git）
/config.yaml
/channel_directory.json
/logs/
.clean_shutdown
/checkpoints/
/sessions/sessions.json
/sessions/*.jsonl
sessions/**/*.jsonl

# SQLite 旁路文件（state.db、sessions/sessions.db 若已跟踪则保留；wal/shm 不提交）
*.db-wal
*.db-shm

# 工具/安装残留
.tirith-install-failed

# 本地 CI venv（勿提交）
.venv-ci/

# 本机打包/下载的二进制（例如 tirith）
/bin/

# 会话遥测（体积大、含运行态；保留同目录 small markdown/json 可手动 add）
/data/*.jsonl

# Project data/ runtime (prompt_builder + gateway status; keep data/.gitkeep)
/data/.skills_snapshot_cache
/data/.skills_prompt_snapshot.json
/data/gateway.pid
/data/gateway_state.json
/data/gateway-locks/
/data/sessions/

# 本地技能草稿 / 机要桥接（若需入库可删对应行后 git add -f）
skills/mimiraether/mimiraether-feishu-config-bridge/

# 运行时备份（勿提交）
data/persistent.json.bak

# 本地 benchmark 产物（physics_reasoner 测试写入仓库根；正式基准见 docs/phase0/*.json）
/baseline_v2_results.json
/pbd_v*_results.json

# 本地 viewer 原型（含 node_modules，非主线）
/viewer/
.worktrees/

/.crew/
/.crew
!.crew/artifacts/
!.crew/graphs/
!.crew/artifacts/.gitkeep
!.crew/graphs/.gitkeep/data/persistent.json
