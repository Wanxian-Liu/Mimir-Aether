 基于 Karpathy autoresearch 架构提取\n对齐: docs/TASKLOOP_ARCH.md + docs/TASKLOOP_PROGRAM.md\n\n用法:\n  python3 scripts/task_loop.py --config data/taskloop_capsule.json\n\n设计约束:\n  - NEVER STOP: 循环中不等人，只读结果→决定→下一轮\n  - 单步5分钟硬时限，超时自动kill\n  - 评测是纯shell数值，绝不依赖LLM判断\n  - Git即记忆: score↑→commit, score↓→reset\n  - 三梯级崩溃: 哑/硬/LLM，只有后两级占轮次\n  - 简洁判据: Δ小但加代码多→不值得保留\n\"\"\"\n\nimport argparse\nimport json\nimport os\nimport subprocess\nimport sys\nimport time\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Optional\n\n# 从本目录导入数据结构\nsys.path.insert(0, str(Path(__file__).resolve().parent))\nfrom task_loop_config import (\n    TaskLoopConfig,\n    RoundState,\n    LoopState,\n    TaskLoopResult,\n    StopReason,\n    CrashTier,\n)\n\n\n# ═══════════════════════════════════════════════════════════\n# 评测\n# ═══════════════════════════════════════════════════════════\n\ndef run_eval(eval_cmd: str, timeout: int = 300, workdir: str = \".\") -> tuple[float, bool, float, Optional[str]]:\n    \"\"\"\n    运行评测命令，返回 (score, ok, duration_s, error).\n    \n    硬约束:\n      - 超时 → kill → 返回 FAIL (TASKLOOP_PROGRAM.md 单步规则)\n      - stdout 末行必须是纯数值\n      - 评测框架本身绝不修改 (一个文件原则)\n    \"\"\"\n    try:\n        start = time.time()\n        proc = subprocess.run(\n            eval_cmd,\n            shell=True,\n            capture_output=True,\n            text=True,\n            timeout=timeout,\n            cwd=workdir,\n        )\n        elapsed = time.time() - start\n\n        if proc.returncode != 0:\n            return -1.0, False, elapsed, f\"exit_code={proc.returncode}; stderr={proc.stderr[-200:]}\"\n\n        # 从 stdout 末行提取数值\n        lines = [l.strip() for l in proc.stdout.strip().split(\"\\n\") if l.strip()]\n        if not lines:\n            return -1.0, False, elapsed, \"stdout empty\"\n        try:\n            score = float(lines[-1])\n        except ValueError:\n            return -1.0, False, elapsed, f\"stdout末行非数值: {lines[-1][:100]}\"\n\n        return score, True, elapsed, None\n\n    except subprocess.TimeoutExpired:\n        elapsed = timeout\n        return -1.0, False, elapsed, f\"超时>{timeout}s\"\n\n\n# ═══════════════════════════════════════════════════════════\n# 崩溃分级 — TASKLOOP_ARCH.md §4.1\n# ═══════════════════════════════════════════════════════════\n\ndef classify_crash(error: str) -> CrashTier:\n    \"\"\"\n    三梯级崩溃分类:\n      梯级1 哑崩溃 — typo/import/语法 → 不占轮次\n      梯级2 硬崩溃 — OOM/超时/架构 → 占轮次，记录crash\n      梯级3 LLM自身失败 — API超时/429 → DEAD_END\n    \"\"\"\n    error_lower = error.lower()\n\n    # 梯级1: 哑崩溃\n    dumb_keywords = [\n        \"nameerror\", \"syntaxerror\", \"indentationerror\", \"attributeerror\",\n        \"modulenotfounderror\", \"importerror\", \"typeerror:\",\n    ]\n    for kw in dumb_keywords:\n        if kw.lower() in error_lower:\n            return CrashTier.DUMB\n\n    # 梯级3: LLM自身\n    llm_keywords = [\"429\", \"rate limit\", \"api timeout\", \"too many requests\"]\n    for kw in llm_keywords:\n        if kw.lower() in error_lower:\n            return CrashTier.LLM_FAIL\n\n    # 梯级2: 其他都是硬崩溃\n    return CrashTier.HARD\n\n\n# ═══════════════════════════════════════════════════════════\n# 简洁判据 — TASKLOOP_ARCH.md §4.2\n# ═══════════════════════════════════════════════════════════\n\ndef should_keep(old_score: float, new_score: float, lines_changed: int) -> tuple[bool, str]:\n    \"\"\"\n    返回 (keep, reason).\n    \n    Δ > 0 且 改动 ≤ 10 行 → keep   (简洁改进)\n    Δ > 0 且 改动 > 30 行 → 仅当 Δ ≥ 0.005 才 keep\n    Δ = 0 且 改动 = 删代码   → keep   (简化等效)\n    Δ < 0 → discard\n    \"\"\"\n    delta = new_score - old_score\n\n    if delta < 0:\n        return False, f\"Δ={delta:.6f}<0 → discard\"\n\n    if lines_changed <= 10:\n        return True, f\"Δ={delta:.6f}, {lines_changed}行 → keep (简洁改进)\"\n\n    if lines_changed > 30:\n        if delta >= 0.005:\n            return True, f\"Δ={delta:.6f}≥0.005, {lines_changed}行 → keep (大幅改进)\"\n        else:\n            return False, f\"Δ={delta:.6f}<0.005, {lines_changed}行>30 → discard (堆代码)\"\n\n    # 10 < lines_changed ≤ 30\n    if delta >= 0.001:\n        return True, f\"Δ={delta:.6f}, {lines_changed}行 → keep\"\n    else:\n        return False, f\"Δ={delta:.6f}<0.001, {lines_changed}行 → discard\"\n\n\n# ═══════════════════════════════════════════════════════════\n# Git 操作 — TASKLOOP_ARCH.md 门控\n# ═══════════════════════════════════════════════════════════\n\ndef git_commit(message: str, workdir: str = \".\") -> Optional[str]:\n    \"\"\"提交并返回 commit hash，失败返回 None。\"\"\"\n    try:\n        r = subprocess.run(\n            [\"git\", \"add\", \"-A\"],\n            capture_output=True, text=True, timeout=30, cwd=workdir\n        )\n        r = subprocess.run(\n            [\"git\", \"commit\", \"-m\", message],\n            capture_output=True, text=True, timeout=30, cwd=workdir\n        )\n        if r.returncode == 0 or \"nothing to commit\" in r.stdout:\n            r2 = subprocess.run(\n                [\"git\", \"rev-parse\", \"--short\", \"HEAD\"],\n                capture_output=True, text=True, timeout=10, cwd=workdir\n            )\n            return r2.stdout.strip()\n        return None\n    except Exception:\n        return None\n\n\ndef git_reset_hard(workdir: str = \".\") -> bool:\n    \"\"\"硬回滚到上次 commit。\"\"\"\n    try:\n        r = subprocess.run(\n            [\"git\", \"reset\", \"--hard\"],\n            capture_output=True, text=True, timeout=30, cwd=workdir\n        )\n        return r.returncode == 0\n    except Exception:\n        return False\n\n\ndef git_diff_stat(workdir: str = \".\") -> int:\n    \"\"\"返回当前未提交改动的行数（新增+删改）。\"\"\"\n    try:\n        r = subprocess.run(\n            [\"git\", \"diff\", \"--stat\"],\n            capture_output=True, text=True, timeout=10, cwd=workdir\n        )\n        # 末行形如 \" 2 files changed, 12 insertions(+), 3 deletions(-)\"\n        last = r.stdout.strip().split(\"\\n\")[-1]\n        total = 0\n        import re\n        ins = re.search(r\"(\\d+) insertion\", last)\n        dels = re.search(r\"(\\d+) deletion\", last)\n        if ins:\n            total += int(ins.group(1))\n        if dels:\n            total += int(dels.group(1))\n        return total\n    except Exception:\n        return 0\n\n\n# ═══════════════════════════════════════════════════════════\n# results.tsv — 实验记录\n# ═══════════════════════════════════════════════════════════\n\ndef init_results_tsv(tsv_path: str) -> None:\n    \"\"\"写 TSV 头（如果文件不存在）。\"\"\"\n    if not os.path.exists(tsv_path):\n        with open(tsv_path, \"w\") as f:\n            f.write(\"timestamp\\tround\\thypothesis\\tscore\\tdelta\\tpassed\\tduration_s\\tcommit_hash\\terror\\n\")\n\n\ndef append_result(tsv_path: str, rs: RoundState) -> None:\n    \"\"\"追加一行。\"\"\"\n    with open(tsv_path, \"a\") as f:\n        f.write(\n            f\"{datetime.now().isoformat()}\\t\"\n            f\"{rs.round}\\t\"\n            f\"{rs.hypothesis}\\t\"\n            f\"{rs.score}\\t\"\n            f\"{rs.delta}\\t\"\n            f\"{rs.passed}\\t\"\n            f\"{rs.duration_s}\\t\"\n            f\"{rs.commit_hash or ''}\\t\"\n            f\"{rs.error or ''}\\n\"\n        )\n\n\n# ═══════════════════════════════════════════════════════════\n# 停止条件 — TASKLOOP_PROGRAM.md\n# ═══════════════════════════════════════════════════════════\n\ndef check_stop(\n    state: LoopState,\n    config: TaskLoopConfig,\n    rounds: list[RoundState],\n    start_time: float,\n) -> Optional[StopReason]:\n    \"\"\"返回停止原因，或 None 继续。\"\"\"\n    # 1. 目标达成\n    if state.best_score >= config.target_score:\n        return StopReason.TARGET_REACHED\n\n    # 2. 轮次耗尽\n    if state.rounds_completed >= config.max_rounds:\n        return StopReason.ROUNDS_EXHAUSTED\n\n    # 3. 时间耗尽\n    elapsed = time.time() - start_time\n    if elapsed >= config.max_time:\n        return StopReason.TIME_EXHAUSTED\n\n    # 4. 连续退化 (5次失败)\n    if state.consecutive_fails >= 5:\n        return StopReason.DEGENERATION\n\n    # 5. 死胡同 — 在外部触发（crash LLM_FAIL 连续2次）\n    #    此处为引擎层检查，由调用方传入\n\n    return None\n\n\n# ═══════════════════════════════════════════════════════════\n# 汇总报告\n# ═══════════════════════════════════════════════════════════\n\ndef summarize(result: TaskLoopResult) -> str:\n    \"\"\"人类可读的循环汇总。\"\"\"\n    lines = [\n        \"=\" * 60,\n        \" TaskLoop 循环结束\",\n        \"=\" * 60,\n        f\"  停止原因: {result.stop_reason.value}\",\n        f\"  最佳分数: {result.best_score:.6f} (第{result.best_round}轮)\",\n        f\"  总轮次:   {result.total_rounds}\",\n        f\"  总耗时:   {result.total_time_s:.1f}s\",\n        f\"  提交数:   {len(result.commits)}\",\n        \"\",\n    ]\n    if result.rounds:\n        lines.append(\"  rounds:\")\n        for r in result.rounds:\n            mark = \"✓\" if r.passed else \"✗\"\n            lines.append(\n                f\"    {mark} R{r.round:02d}  \"\n                f\"score={r.score:.6f}  \"\n                f\"Δ={r.delta:+.6f}  \"\n                f\"{r.hypothesis[:60]}\"\n            )\n    lines.append(\"=\" * 60)\n    return \"\\n\".join(lines)\n\n\n# ═══════════════════════════════════════════════════════════\n# 主循环（不含 LLM — 由调用方注入策略函数）\n# ═══════════════════════════════════════════════════════════\n\ndef run_loop(\n    config: TaskLoopConfig,\n    strategy_fn,  # callable(config, state, rounds) -> dict{hypothesis, patch_file, patch_content}\n    tsv_path: str = \"data/results.tsv\",\n) -> TaskLoopResult:\n    \"\"\"\n    TaskLoop 主循环。\n    \n    Args:\n        config: 任务配置\n        strategy_fn: LLM策略函数，返回本轮修改 (hypothesis + file + patch)\n        tsv_path: results.tsv 路径\n    \n    Returns:\n        TaskLoopResult 包含所有轮次记录和停止原因\n    \"\"\"\n    workdir = config.workdir or \".\"\n    start_time = time.time()\n\n    state = LoopState(\n        best_score=float(\"-inf\"),\n        start_time=start_time,\n    )\n    rounds: list[RoundState] = []\n    init_results_tsv(tsv_path)\n\n    while True:\n        # —— 停止检查 ——\n        stop = check_stop(state, config, rounds, start_time)\n        if stop:\n            state.stop_reason = stop\n            break\n\n        # —— ① LLM 策略+执行 ——\n        try:\n            llm_result = strategy_fn(config, state, rounds)\n        except Exception as e:\n            # LLM自身失败 → 梯级3\n            tier = classify_crash(str(e))\n            if tier == CrashTier.LLM_FAIL:\n                state.consecutive_fails += 1\n                if state.consecutive_fails >= 2:\n                    state.stop_reason = StopReason.DEAD_END\n                    break\n                continue\n            else:\n                # 非LLM异常 → 梯级1，修完继续\n                print(f\"[crash:dumb] {e}\", file=sys.stderr)\n                continue\n\n        hypothesis = llm_result.get(\"hypothesis\", \"no hypothesis\")\n        patch_file = llm_result.get(\"patch_file\", \"\")\n        patch_content = llm_result.get(\"patch_content\", \"\")\n\n        # 安全检查：禁止改 eval_cmd\n        if config.eval_cmd and patch_content and config.eval_cmd in patch_content:\n            print(f\"[safety] 尝试修改 eval_cmd，跳过本轮\", file=sys.stderr)\n            continue\n\n        # 应用修改\n        if patch_file and patch_content:\n            full_path = os.path.join(workdir, patch_file)\n            try:\n                with open(full_path, \"w\") as f:\n                    f.write(patch_content)\n            except Exception as e:\n                print(f\"[crash:dumb] 写入 {patch_file}: {e}\", file=sys.stderr)\n                continue\n\n        # 统计改动行数\n        lines_changed = git_diff_stat(workdir)\n\n        # —— ② 评测 ——\n        score, ok, duration, error = run_eval(\n            config.eval_cmd,\n            timeout=config.eval_timeout,\n            workdir=workdir,\n        )\n\n        # —— ③ 崩溃分级处理 ——\n        if not ok and error:\n            tier = classify_crash(error)\n            if tier == CrashTier.DUMB:\n                # 不占轮次，不计入结果，修完继续\n                print(f\"[crash:dumb] R{state.rounds_completed+1}: {error}\", file=sys.stderr)\n                continue\n            elif tier == CrashTier.HARD:\n                # 占轮次，记录crash\n                rs = RoundState(\n                    round=state.rounds_completed + 1,\n                    hypothesis=hypothesis,\n                    score=-1.0,\n                    delta=0,\n                    passed=False,\n                    duration_s=duration,\n                    error=f\"crash(hard): {error}\",\n                )\n                rounds.append(rs)\n                append_result(tsv_path, rs)\n                state.rounds_completed += 1\n                state.consecutive_fails += 1\n                git_reset_hard(workdir)\n                print(f\"[crash:hard] R{rs.round}: {error}\", file=sys.stderr)\n                continue\n            else:  # LLM_FAIL\n                state.consecutive_fails += 1\n                if state.consecutive_fails >= 2:\n                    state.stop_reason = StopReason.DEAD_END\n                    break\n                continue\n\n        # —— ④ 门控：简洁判据 ——\n        if ok and score > state.best_score:\n            keep, reason = should_keep(state.best_score if state.best_score > float(\"-inf\") else score - 0.001,\n                                       score, lines_changed)\n            if keep:\n                commit_msg = f\"R{state.rounds_completed+1}: {hypothesis} (score={score:.4f})\"\n                commit_hash = git_commit(commit_msg, workdir)\n                state.best_score = score\n                state.best_round = state.rounds_completed + 1\n                state.consecutive_fails = 0\n            else:\n                git_reset_hard(workdir)\n                commit_hash = None\n                ok = False\n                error = f\"门控拒绝: {reason}\"\n                state.con