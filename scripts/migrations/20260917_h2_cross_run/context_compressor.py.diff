+    # ── H2（2026-09-17）：挂账的**跨 run 持久化** ──────────────────────────
+    def bind_session(self, session_key) -> None:
+        """绑定会话身份（gateway 的 ``session_id`` = 对话身份，跨 run 稳定）。
+
+        空键 ⇒ **不绑定**（fail-closed）：没有会话身份就不写跨 run 挂账 ——
+        宁可漏一次结算，也不把 A 会话的账结到 B 会话头上。
+        """
+        try:
+            _k = str(session_key or "").strip()
+        except Exception:
+            _k = ""
+        if _k:
+            self._session_key = _k
+
+    def _pending_store_path(self):
+        """挂账落盘路径；**未绑定会话 ⇒ None**（不落盘、不认领）。"""
+        _k = str(getattr(self, "_session_key", "") or "")
+        if not _k:
+            return None
+        try:
+            from mimir_constants import get_mimir_home
+            _h = get_mimir_home()
+        except Exception:
+            return None
+        _tag = hashlib.sha256(_k.encode("utf-8")).hexdigest()[:16]  # 只落指纹
+        return _h.joinpath(*_PENDING_STORE_DIRS) / (_tag + ".json")
+
+    def _persist_pending(self, pend) -> bool:
+        """原子落盘（tmp + ``os.replace``）—— 供**下一个 run** 结算。"""
+        _p = self._pending_store_path()
+        if _p is None:
+            return False
+        try:
+            _p.parent.mkdir(parents=True, exist_ok=True)
+            _rec = dict(pend)
+            _rec["store_version"] = _PENDING_STORE_VERSION
+            _tmp = _p.with_name(_p.name + ".tmp.%d" % os.getpid())
+            with open(_tmp, "w", encoding="utf-8") as _f:
+                json.dump(_rec, _f, ensure_ascii=False)
+            os.replace(_tmp, _p)          # 原子：读者要么见旧、要么见新，不见半截
+            return True
+        except Exception as _e:
+            logger.debug("[H2] pending persist skipped: %s", _e)
+            return False
+
+    def _claim_pending(self):
+        """原子认领**上一个 run** 落盘的账。返回 ``(rec | None, why)``。
+
+        **跨进程单飞**靠 ``os.replace``：两个 run 同时到，只有 rename 成功者拿到账，
+        另一个得 ``why="raced"`` ⇒ 同一笔账不会被结两次（这正是「一账最多结一次」
+        从**进程内**推广到**跨 run** 的关键一行）。
+        """
+        _p = self._pending_store_path()
+        if _p is None or not _p.exists():
+            return None, "none"
+        _c = _p.with_name(_p.name + ".claimed.%d" % os.getpid())
+        try:
+            os.replace(_p, _c)
+        except Exception:
+            return None, "raced"
+        try:
+            _rec = json.loads(_c.read_text(encoding="utf-8"))
+        except Exception:
+            _rec = None
+        finally:
+            try:
+                _c.unlink()
+            except Exception:
+                pass
+        if not isinstance(_rec, dict):
+            return None, "unreadable"
+        if str(_rec.get("store_version") or "") != _PENDING_STORE_VERSION:
+            return None, "version"
+        return _rec, "ok"
+
