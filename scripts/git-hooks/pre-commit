#!/usr/bin/sh
# MimirAether pre-commit hook -- attribution guard (Q3-B / B4 / G-5)
# ---------------------------------------------------------------------------
# Ruling: 2026-09-12 Hermes audit receipt on card
#   wiki/discussions/2026-09-12-四方讨论-唤醒单例与并发写治理-Q3.md
#   "B4 (do not amend a commit you did not author) becomes a commit-time gate,
#    not prose -- hook + overridable + traceable."
#
# Why a hook: on 2026-09-12 two runs of the same gateway process interleaved
# commits and one amended a commit made two seconds earlier. At runtime nobody
# can tell "not mine" when attribution is broken, so the rule is designed as
# "if it cannot be decided, forbid it".
#
# Behaviour
#   1. amend of a commit whose author/committer identity differs from the
#      current committer identity  ->  BLOCK
#      override: MIMIR_ALLOW_FOREIGN_AMEND=1 (allowed, but traced as override)
#   2. every invocation is traced (one JSON line) to
#      $MIMIR_GIT_COMMIT_AUDIT_LOG or ~/.mimiraether/logs/git-commit-audit.jsonl
#   3. non-amend commits are never blocked; a non-Mimir identity only warns
#      (Hermes may land audit segments in this repo -- see
#       docs/AGENT_REPO_OWNERSHIP.md).
#
# Amend detection (git 2.43 exposes neither GIT_REFLOG_ACTION nor an amend flag
# to pre-commit -- measured 2026-09-12): walk the process ancestry (ps) to the
# FIRST ancestor that is a git command and inspect its argv for --amend.
# prepare-commit-msg would be unreliable here: `git commit --amend -m X` passes
# source=message, indistinguishable from a normal commit.
#
# Install:  sh scripts/install-git-hooks.sh
# Bypass:   git commit --no-verify  (deliberately NOT traced: the *absence* of a
#           trace line next to a commit is itself the signal)
# ---------------------------------------------------------------------------
# 2026-10-07（卡 24 / #23 · 刘哥批「投」）-- 「拦自己人」根治：fleet 协作身份集合
#   病：Mimir 与 Hermes 在**同一个仓**里接续干活，正当 amend（如给上一条补 `Agent:` 尾巴）
#       也被判 foreign ⇒ 日常靠 MIMIR_ALLOW_FOREIGN_AMEND=1 绕 ⇒ **判据失效**
#       （「该拦的真偷改」与「不该拦的正当修复」共用同一把钥匙）。
#   方：引入协作身份集合（fleet）——HEAD 作者/提交者与当前 committer **都在 fleet** ⇒ 放行
#       （exit 0），但**照留痕**（trace outcome=amend-fleet，含双方身份）；
#       任一方不在 fleet / 认不出 ⇒ **行为一个字不改**（出声 + 两条出路 + trace + exit 1）。
#   fleet 取证（2026-10-07 · `git log --format='%an <%ae>'` / `%cn <%ce>` 全量实取）：
#     Mimir       : Mimir|mimir|MimirAether + mimir@{mimiraether.local,local,mimir.aether,worldweaver.ai,mimiraether}
#     Hermes(琬弦) : 琬弦 <wanxian@worldweaver.ai>（824 次）· 另 Wanxian-Liu <***@gmail.com>（作者 21 次 · 原值已脱敏 2026-10-08）
#     Loki        : Loki <loki@MiniMax.local>（1 次）
#     OpenClaw    : **未观测到作者/提交者身份，暂不纳入**（无取证的白名单 = 白名单腐化）；
#                   未纳入 GitHub <noreply@github.com>（合并器，非协作身份）。
#   override 上巡视面（同批硬约束②）：每次 override 除 trace jsonl 外，追加一行到
#     <mimir_home>/data/ops/hook_observations.jsonl（hook=git_foreign_amend_override）
#     —— 该文件是 scripts/slo_dashboard.py::hook_obs_section() 的数据源，渲染进日报
#        「## ⑥ 钩子观测」表格；cron `mimir-slo-dashboard`（0 22 * * *）每日出报
#        ⇒ override 次日必在**巡视读面**出现一次（不再只躺 jsonl）。
# ---------------------------------------------------------------------------

# 2026-09-16 修「审计台账双血统」：本机 HOME 即 mimir home ⇒ 旧写法 $HOME/.mimiraether 得到
# **嵌套假路径**（真台账 2620 行 vs 嵌套 101 行，我的提交只进嵌套）。
# 判据改为「挑真的含 logs/ 的那一个」——与 scripts/f2c_sample_ledger.py 的解析同源。
_mimir_home() {
  if [ -n "${MIMIR_HOME:-}" ] && [ -d "${MIMIR_HOME}/logs" ]; then printf '%s' "$MIMIR_HOME"; return; fi
  if [ -n "${MIMIR_AETHER_HOME:-}" ] && [ -d "${MIMIR_AETHER_HOME}/logs" ]; then printf '%s' "$MIMIR_AETHER_HOME"; return; fi
  # 2026-09-16 修正（定位第 3 条台账）：旧序把 "$HOME/logs" 排在 "$HOME/.mimiraether/logs" 之前，
  # 而 /home/<user>/logs 是 2026-03 就存在的旧目录 ⇒ 对 HOME=/home/<user> 的执行面（其他 agent 的提交）
  # 恒命中它 ⇒ 产出「第 3 条台账」/home/<user>/logs/git-commit-audit.jsonl。
  # 修正：规范路径优先；与调用方 HOME 形状无关（HOME=<...>/.mimiraether 时嵌套不存在，自然回落）。
  if [ -d "$HOME/.mimiraether/logs" ]; then printf '%s' "$HOME/.mimiraether"; return; fi
  if [ -d "$HOME/logs" ]; then printf '%s' "$HOME"; return; fi
  printf '%s' "$HOME/.mimiraether"
}
TRACE_LOG="${MIMIR_GIT_COMMIT_AUDIT_LOG:-$(_mimir_home)/logs/git-commit-audit.jsonl}"
AGENT_ID="${MIMIR_AGENT_ID:-mimir}"
TRACE_ID="${MIMIR_TRACE_ID:-}"

_detect_amend() {
  case "${GIT_REFLOG_ACTION:-}" in *amend*) return 0 ;; esac
  [ "${MIMIR_HOOK_FORCE_AMEND:-0}" = "1" ] && return 0
  _p=$$
  _i=0
  while [ "$_i" -lt 6 ]; do
    _pp=$(ps -o ppid= -p "$_p" 2>/dev/null | tr -d ' ')
    [ -z "$_pp" ] && break
    [ "$_pp" = "0" ] && break
    _args=$(ps -o args= -p "$_pp" 2>/dev/null)
    case "$_args" in
      git\ *|*/git\ *)
        case "$_args" in
          *--amend*) return 0 ;;
        esac
        return 1
        ;;
    esac
    _p=$_pp
    _i=$((_i + 1))
  done
  return 1
}

# 巡视面（硬约束②）：override 追加落点 —— 与 agent/hook_observe.py 同文件同 schema 子集，
# 该文件由 scripts/slo_dashboard.py::hook_obs_section() 读入日报「⑥ 钩子观测」，cron 每日渲染。
HOOK_OBS_LOG="${MIMIR_HOOK_OBS_PATH:-$(_mimir_home)/data/ops/hook_observations.jsonl}"

# --- fleet（协作身份集合）-----------------------------------------------------
# 判据形态：POSIX case 模式（**不用 tr/locale**——CJK 姓名按字节模式匹配，避免管道进解释器与
# 大小写折叠的额外依赖）。$1 = 姓名，$2 = 邮箱；两者任一命中即视为 fleet 成员。
# 邮箱按**域**匹配而非逐值白名单：实测同一 agent 有 5 种 mimir@* 写法（见文件头取证）。
_is_fleet_identity() {
  case "${1:-}" in
    Mimir|mimir|MIMIR|MimirAether|mimiraether|MIMIRAETHER) return 0 ;;
    琬弦*|Wanxian*|wanxian*) return 0 ;;
    Loki|loki|LOKI) return 0 ;;
  esac
  case "${2:-}" in
    mimir@*|Mimir@*|MIMIR@*) return 0 ;;
    wanxian@*|Wanxian@*|WANXIAN@*) return 0 ;;
    *@worldweaver.ai|*@WorldWeaver.ai) return 0 ;;
    loki@*|Loki@*) return 0 ;;
  esac
  return 1
}

# override 留痕上巡视面：append 一行（一行一事件，追加写；与 python 侧 writer 同文件）
_append_hook_obs_override() {
  case "${MIMIR_HOOK_OBSERVE:-1}" in
    0|false|no|off|False|FALSE|No|NO|Off|OFF) return 0 ;;
  esac
  _dir=$(dirname "$HOOK_OBS_LOG" 2>/dev/null)
  [ -n "$_dir" ] && mkdir -p "$_dir" 2>/dev/null
  printf '{"ts":"%s","hook":"git_foreign_amend_override","decision":"override","reason":"MIMIR_ALLOW_FOREIGN_AMEND=1","head_author":"%s <%s>","committer":"%s <%s>","repo":"%s","branch":"%s","trace_id":"%s","pid":%s}\n' \
    "$(date +%Y-%m-%dT%H:%M:%S)" \
    "$_head_author_name" "$_head_author_email" "$_cur_name" "$_cur_email" \
    "$_repo" "$_branch" "$TRACE_ID" "$$" >> "$HOOK_OBS_LOG" 2>/dev/null
  return 0
}

_is_amend=0
_detect_amend && _is_amend=1

_repo=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
_cur_name=$(git config user.name 2>/dev/null || printf '')
_cur_email=$(git config user.email 2>/dev/null || printf '')
_head_author_name=$(git log -1 --format='%an' 2>/dev/null || printf '')
_head_author_email=$(git log -1 --format='%ae' 2>/dev/null || printf '')
_head_committer_name=$(git log -1 --format='%cn' 2>/dev/null || printf '')
_head_committer_email=$(git log -1 --format='%ce' 2>/dev/null || printf '')
_head=$(git rev-parse -q --verify HEAD 2>/dev/null || printf 'no-head')
_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || printf '')
_diff_files=$(git diff --cached --name-only 2>/dev/null | wc -l | tr -d ' ')

_trace() {
  _outcome="$1"
  _override="$2"
  _dir=$(dirname "$TRACE_LOG" 2>/dev/null)
  [ -n "$_dir" ] && mkdir -p "$_dir" 2>/dev/null
  printf '{"ts":"%s","agent_id":"%s","trace_id":"%s","action":"%s","outcome":"%s","override":"%s","repo":"%s","branch":"%s","head_before":"%s","head":"%s","amend":"%s","committer":"%s <%s>","head_author":"%s <%s>","staged_files":%s,"pid":%s}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$AGENT_ID" "$TRACE_ID" \
    "$([ "$_is_amend" = "1" ] && printf 'amend' || printf 'commit')" \
    "$_outcome" "$_override" "$_repo" "$_branch" "$_head" "$_head" "$_is_amend" \
    "$_cur_name" "$_cur_email" "$_head_author_name" "$_head_author_email" \
    "$_diff_files" "$$" >> "$TRACE_LOG" 2>/dev/null
}

# --- 个人信息闸（2026-10-08 · 快速会议 §6 规则 R3 / N7 选项 A）-------------------
# 病（实测）：为修闸而把**身份清单逐字抄进公开仓文档** —— pre-commit:43 与
#   docs/24-amend-fleet-gate-worklog.md:41 本就写着个人 Gmail ⇒ 闸的取证材料自己
#   成了泄漏源（L58 口径：抽样面之外多出来的那一份，恰是最脏的那份）。
# 方：只查**本次暂存的新增行**（不追历史、不改旧行），命中即 BLOCK 并给改法。
#
# 规则分两层（本闸第一版犯过同一个错：把要保护的串抄进了公开钩子，故改为分层）：
#   ① 通用形态 → 进公开仓，**不含任何具体字符串**：个人邮箱域 + 任意用户的绝对 home 路径
#   ② 具体串（本名 / 本机用户名 / 拼音变体）→ **本地未跟踪清单**
#      ${MIMIR_PERSONAL_PATTERNS:-$(_mimir_home)/personal-patterns.txt}（一行一条）
# override: MIMIR_ALLOW_PERSONAL_INFO=1（照留痕）。
_pi_re='[A-Za-z0-9._%+-]+@(gmail|qq|163|126|outlook|hotmail|foxmail|yeah)\.(com|net|cn)([^A-Za-z0-9]|$)|/home/[A-Za-z][A-Za-z0-9_.-]*/|/Users/[A-Za-z]'
_pi_file="${MIMIR_PERSONAL_PATTERNS:-$(_mimir_home)/personal-patterns.txt}"
_pi_added=$(git diff --cached -U0 2>/dev/null | grep -E '^\+[^+]')
_pi_hits=$(printf '%s\n' "$_pi_added" | grep -nE "$_pi_re" 2>/dev/null | head -5)
if [ -z "$_pi_hits" ] && [ -f "$_pi_file" ]; then
  _pi_hits=$(printf '%s\n' "$_pi_added" | grep -nF -f "$_pi_file" 2>/dev/null | head -5)
fi
if [ -n "$_pi_hits" ]; then
  if [ "${MIMIR_ALLOW_PERSONAL_INFO:-0}" = "1" ]; then
    printf 'pre-commit: WARNING -- 新增行含个人信息（override 已留痕）\n' >&2
    _trace "personal-info-override" "true"
  else
    _trace "personal-info-blocked" "false"
    printf '\npre-commit: BLOCKED -- 暂存的新增行含个人信息\n' >&2
    printf '%s\n' "$_pi_hits" | sed 's/^/  /' >&2
    printf '  rule   : 公开仓文档/代码禁出现个人邮箱 · 本机用户名 · 本名形态 · 绝对 home 路径\n' >&2
    printf '  why    : 2026-10-08 实测 —— 为修闸把身份清单写进公网文档，闸的取证材料成了泄漏源\n' >&2
    printf '  instead: 写成掩码（***@gmail.com）或用 $HOME / ~/ 代替绝对路径\n' >&2
    printf '  override (traced): MIMIR_ALLOW_PERSONAL_INFO=1 git commit ...\n\n' >&2
    exit 1
  fi
fi

if [ "$_is_amend" = "1" ] && [ "$_head" != "no-head" ]; then
  _foreign=0
  [ "$_head_author_name" != "$_cur_name" ] && _foreign=1
  [ "$_head_author_email" != "$_cur_email" ] && _foreign=1
  [ -n "$_head_committer_name" ] && [ "$_head_committer_name" != "$_cur_name" ] && _foreign=1
  [ -n "$_head_committer_email" ] && [ "$_head_committer_email" != "$_cur_email" ] && _foreign=1

  # fleet 判定（卡 24 / #23）：HEAD 作者/提交者 与 当前 committer 是否都是协作身份
  _head_fleet=0
  _cur_fleet=0
  _is_fleet_identity "$_head_author_name" "$_head_author_email" && _head_fleet=1
  _is_fleet_identity "$_head_committer_name" "$_head_committer_email" && _head_fleet=1
  _is_fleet_identity "$_cur_name" "$_cur_email" && _cur_fleet=1

  if [ "$_foreign" = "1" ] && [ "$_head_fleet" = "1" ] && [ "$_cur_fleet" = "1" ]; then
    # 同仓接续干活（Mimir<->Hermes<->Loki）：放行，但**不静默** —— 留痕 amend-fleet（含双方身份）
    printf 'pre-commit: OK -- fleet amend: %s <%s> amending commit authored/committed by %s <%s> (traced as amend-fleet)\n' \
      "$_cur_name" "$_cur_email" "$_head_author_name" "$_head_author_email" >&2
    _trace "amend-fleet" "false"
  elif [ "$_foreign" = "1" ]; then
    if [ "${MIMIR_ALLOW_FOREIGN_AMEND:-0}" = "1" ]; then
      printf 'pre-commit: WARNING -- amending a commit authored by %s <%s> with identity %s <%s> (override traced)\n' \
        "$_head_author_name" "$_head_author_email" "$_cur_name" "$_cur_email" >&2
      _trace "amend-foreign-override" "true"
      _append_hook_obs_override
    else
      _trace "amend-foreign-blocked" "false"
      printf '\n' >&2
      printf 'pre-commit: BLOCKED -- foreign amend\n' >&2
      printf '  HEAD was authored/committed by : %s <%s>\n' "$_head_author_name" "$_head_author_email" >&2
      printf '  your committer identity is     : %s <%s>\n' "$_cur_name" "$_cur_email" >&2
      printf '  rule   : Q3-B / B4 -- do not amend a commit that is not yours\n' >&2
      printf '  reason : when attribution is broken "not mine" cannot be judged at\n' >&2
      printf '           runtime, so the rule is "if undecidable, forbid"\n' >&2
      printf '  instead: make a follow-up commit (squash/fixup = explicit attributed\n' >&2
      printf '           history rewrite; amend = silent rewrite)\n' >&2
      printf '  override (traced): MIMIR_ALLOW_FOREIGN_AMEND=1 git commit --amend ...\n\n' >&2
      exit 1
    fi
  else
    _trace "amend-own" "false"
  fi
else
  if [ "$_cur_name" != "Mimir" ]; then
    printf 'pre-commit: note -- committer identity is "%s" (repo default is "Mimir"; see docs/AGENT_REPO_OWNERSHIP.md)\n' "$_cur_name" >&2
    _trace "commit-non-mimir-identity" "false"
  else
    _trace "commit" "false"
  fi
fi

exit 0
