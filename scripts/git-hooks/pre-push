#!/bin/sh
# MimirAether pre-push hook -- immutable evidence (A6; 2026-09-13)
# ---------------------------------------------------------------------------
# Ruling: 刘哥, 2026-09-13 (four-party card 2026-09-13-四方审计-Mimir归因署名与
# 注入修复-闭环与联合计划.md, Q4): "本仓 pre-push 做; wiki 禁 force-push 做;
# GitHub branch protection 留刘哥". Layer 1 (this repo) and layer 2 (~/wiki) are
# the same hook; layer 3 is outside this process.
#
# Why a gate and not prose: an attribution that a rewrite can silently erase is
# not evidence. Section 8 of docs/AGENT_REPO_OWNERSHIP.md says rewrites are never
# acceptable here -- so the rule becomes a push-time gate, overridable and
# traced, instead of a sentence nobody can check afterwards.
#
# Behaviour
#   1. non-fast-forward (the remote tip is not an ancestor of the local tip)
#      -> BLOCK. This is the rewrite that silently deletes other people's
#      history, whether or not the command line said the word "force".
#   2. an explicit force form in the push argv -- "--force" / "-f" /
#      "--force-with-lease" / "--force-if-includes" / a "+refspec" -> BLOCK.
#      Rationale: a lease protects against a third party writing, not against
#      rewriting shared history; and the ruling names these forms explicitly.
#   3. the remote tip object is missing locally, so fast-forward cannot be
#      decided -> BLOCK ("if it cannot be decided, forbid" -- the same rule as
#      the pre-commit foreign-amend gate).
#   4. deleting a remote branch -> recorded and warned, NOT blocked (deletion is
#      not a rewrite; the record is what makes it reviewable).
#   5. every invocation appends one JSON line to the SAME audit stream the other
#      two hooks use (no third file -- X1/X2/X3).
#
# Override (traced): export MIMIR_ALLOW_FORCE_PUSH=1 before the push.
# Test seam: MIMIR_HOOK_FORCE_PUSH_ARGS="..." substitutes the push argv that
#            would otherwise be read from the process ancestry (same pattern as
#            MIMIR_HOOK_FORCE_AMEND in the pre-commit hook).
#
# Install:  sh scripts/install-git-hooks.sh                 (this repo)
#           sh scripts/install-git-hooks.sh --repo ~/wiki   (shared repo)
# Bypass:   add --no-verify to the push command (absence of a trace line is
#           itself the signal).
# ---------------------------------------------------------------------------
set -u

# 2026-09-16 修「审计台账双血统」：本机 HOME 即 mimir home ⇒ 旧写法得到**嵌套假路径**
# （实测：真台账 2620 行 vs 嵌套 101 行，我的提交只进嵌套）。判据 = 挑真含 logs/ 的那一个。
_mimir_home() {
  if [ -n "${MIMIR_HOME:-}" ] && [ -d "${MIMIR_HOME}/logs" ]; then printf '%s' "$MIMIR_HOME"; return; fi
  if [ -n "${MIMIR_AETHER_HOME:-}" ] && [ -d "${MIMIR_AETHER_HOME}/logs" ]; then printf '%s' "$MIMIR_AETHER_HOME"; return; fi
  # 2026-09-16 修正（定位第 3 条台账）：旧序把 "$HOME/logs" 排在 "$HOME/.mimiraether/logs" 之前，
  # 而 /home/<user>/logs 是 2026-03 就存在的旧目录 ⇒ 对 HOME=/home/<user> 的执行面（其他 agent 的提交）
  # 恒命中它 ⇒ 产出「第 3 条台账」/home/<user>/logs/git-commit-audit.jsonl。
  # 修正：规范路径优先；与调用方 HOME 形状无关（HOME=<...>/.mimiraether 时嵌套不存在，自然回落）。
  if [ -d "$HOME/.mimiraether/logs" ]; then printf '%s' "$HOME/.mimiraether"; return; fi
  if [ -d "$HOME/logs" ]; then printf '%s' "$HOME"; return; fi
  printf '%s' "$HOME/.mimiraether"
}
TRACE_LOG="${MIMIR_GIT_COMMIT_AUDIT_LOG:-$(_mimir_home)/logs/git-commit-audit.jsonl}"
AGENT_ID="${MIMIR_AGENT_ID:-mimir}"
TRACE_ID="${MIMIR_TRACE_ID:-}"
ZERO=0000000000000000000000000000000000000000

_remote="${1:-}"
_url="${2:-}"
_repo=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || printf '')

_tmp="${TMPDIR:-/tmp}/mimir-prepush.$$"
if ! cat > "$_tmp" 2>/dev/null; then
  : > "$_tmp"
fi

# The push command line is not passed to the hook, so walk the process ancestry
# to the first git command and read its argv (measured working in the pre-commit
# hook; git 2.43 exposes no flag for this).
_push_argv() {
  if [ -n "${MIMIR_HOOK_FORCE_PUSH_ARGS:-}" ]; then
    printf '%s' "$MIMIR_HOOK_FORCE_PUSH_ARGS"
    return 0
  fi
  _p=$$
  _i=0
  while [ "$_i" -lt 6 ]; do
    _pp=$(ps -o ppid= -p "$_p" 2>/dev/null | tr -d ' ')
    [ -z "$_pp" ] && return 1
    [ "$_pp" = "0" ] && return 1
    _args=$(ps -o args= -p "$_pp" 2>/dev/null)
    case "$_args" in
      git\ push*|*/git\ push*) printf '%s' "$_args"; return 0 ;;
      git\ *|*/git\ *) return 1 ;;
    esac
    _p=$_pp
    _i=$((_i + 1))
  done
  return 1
}

_force_intent=0
_argv=$(_push_argv 2>/dev/null || printf '')
if [ -n "$_argv" ]; then
  case "$_argv" in
    *--force-with-lease*|*--force-if-includes*|*--force*) _force_intent=1 ;;
  esac
  case " $_argv " in
    *" -f "*) _force_intent=1 ;;
  esac
  case " $_argv " in
    *" +"*) _force_intent=1 ;;
  esac
fi

_block=0
_reason=""
_outcome="push-fast-forward"
_refs=0
_deleted=0

while read -r _lref _lsha _rref _rsha; do
  [ -z "${_lref:-}" ] && continue
  _refs=$((_refs + 1))
  case "$_lsha" in
    "$ZERO")
      _deleted=$((_deleted + 1))
      printf 'pre-push: note -- deleting remote ref %s (recorded; a deletion is not a rewrite)\n' "$_rref" >&2
      continue
      ;;
  esac
  case "$_rsha" in
    "$ZERO") continue ;;
  esac
  if ! git cat-file -e "${_rsha}^{commit}" 2>/dev/null; then
    if [ "$_block" = "0" ]; then
      _block=1
      _outcome="push-undecidable-blocked"
      _reason="remote object ${_rsha} is not present locally: fast-forward cannot be decided"
    fi
    continue
  fi
  if ! git merge-base --is-ancestor "$_rsha" "$_lsha" 2>/dev/null; then
    if [ "$_block" = "0" ]; then
      _block=1
      _outcome="push-non-fast-forward-blocked"
      _reason="remote ${_rsha} is not an ancestor of local ${_lsha} (non-fast-forward)"
    fi
  fi
done < "$_tmp"

# ---------------------------------------------------------------------------
# 3b. published-secret scan (R6; 2026-09-26; extended the same day to Feishu
#     identifiers and key shapes). A push whose ADDED lines carry an absolute
#     home path, a Feishu id or a key shape publishes something the public repo
#     must not carry. Added lines only -- frozen snapshots already committed are
#     not re-litigated.
#     The home-path needle is built from $(id -un): a hook that spelled the name
#     out would be the very leak it exists to catch.
#     Allowlist: scripts/migrations/ (frozen execution snapshots -- editing them
#     would falsify the audit trail, so they stay as-is).
#     Override (traced): export MIMIR_ALLOW_PATH_LEAK=1
#     Test seam: MIMIR_PATH_LEAK_NEEDLE overrides the derived home name.
#     Each entry below is "name|regex" and must be a SHAPE, never a prefix.
#     Measured 2026-09-26 on this tree (subprocess argv, no shell layer -- the
#     first measurement double-escaped the ERE and reported 0 for everything):
#     a bare "oc_" matches 201 lines and a bare "sk-" 108, so a prefix gate
#     would block ordinary pushes until someone switched it off, which is how a
#     gate turns into decoration. Every shape here matches 0 lines at HEAD.
#     The "sk-" floor is 32, not 20: at 20 this tree already trips twice on
#     documentation examples of key-detection rules, and a gate that fires on
#     docs is a gate people learn to override. Real keys are >= 32 (the one the
#     2026-09-25 audit found was 35).
#     Regexes must not contain "|" (the field separator).
# ---------------------------------------------------------------------------
EMPTY_TREE=4b825dc642cb6eb9a060e54bf8d69288fbee4904
_needle="${MIMIR_PATH_LEAK_NEEDLE:-}"
if [ -z "$_needle" ]; then
  _me=$(id -un 2>/dev/null || printf '')
  [ -n "$_me" ] && _needle="/home/$_me"
fi
_patterns=""
[ -n "$_needle" ] && _patterns="home-path|${_needle}"
_patterns="${_patterns}
feishu-chat-id|oc_[0-9a-f]{32}
feishu-open-id|ou_[0-9a-f]{32}
api-key-sk|sk-[A-Za-z0-9]{32,}"
_leak_hits=0
_leak_files=""
_leak_which=""
if [ -s "$_tmp" ]; then
  while read -r _lref _lsha _rref _rsha; do
    [ -z "${_lref:-}" ] && continue
    case "$_lsha" in "$ZERO") continue ;; esac
    _base="$_rsha"
    while IFS='|' read -r _pname _pre; do
      [ -z "${_pname:-}" ] && continue
      [ -z "${_pre:-}" ] && continue
      if [ "$_rsha" = "$ZERO" ]; then
        # The ref does not exist on the remote: pushing it publishes the WHOLE
        # tree, so the whole tree is what gets scanned. Diffing against the
        # merge-base instead would only see what the branch adds on top of its
        # own fork point -- and when the fork point is stale (measured
        # 2026-09-26: 813 commits behind), everything cleaned up since stays
        # invisible while still being published. That is the shape that hid
        # this very branch.
        _hits=$(git grep -cE -- "$_pre" "$_lsha" -- . ':(exclude)scripts/migrations/*' 2>/dev/null \
                  | awk -F: '{s += $NF} END {print s + 0}')
        case "$_hits" in ''|*[!0-9]*) _hits=0 ;; esac
        _flist=$(git grep -lE -- "$_pre" "$_lsha" -- . ':(exclude)scripts/migrations/*' 2>/dev/null \
                   | sed 's/^[^:]*://' | head -5 | tr '\n' ' ')
      else
        # The ref already exists on the remote, so only the added lines are new.
        _hits=$(git diff --diff-filter=ACMR --unified=0 "$_base" "$_lsha" \
                  -- . ':(exclude)scripts/migrations/*' 2>/dev/null \
                | grep -E '^[+]' | grep -vE '^[+][+][+] ' \
                | grep -cE -- "$_pre" | head -1)
        case "$_hits" in ''|*[!0-9]*) _hits=0 ;; esac
        _flist=$(git diff --name-only --diff-filter=ACMR "$_base" "$_lsha" \
                   -- . ':(exclude)scripts/migrations/*' 2>/dev/null | head -5 | tr '\n' ' ')
      fi
      if [ "$_hits" -gt 0 ] 2>/dev/null; then
        _leak_hits=$((_leak_hits + _hits))
        [ -n "$_flist" ] && _leak_files="$_leak_files $_flist"
        _leak_which="$_leak_which ${_pname}(${_hits})"
      fi
    done <<PATTERNS
$_patterns
PATTERNS
  done < "$_tmp"
fi
rm -f "$_tmp"

if [ "$_leak_hits" -gt 0 ] 2>/dev/null; then
  if [ "$_block" = "0" ]; then
    _block=1
    _outcome="push-path-leak-blocked"
    _reason="added lines publish protected shapes (${_leak_hits} hit(s):${_leak_which})"
  else
    _reason="$_reason; plus ${_leak_hits} published-secret hit(s)"
  fi
  _leak_note="  files  :$(printf '%s' "$_leak_files" | cut -c1-300)"
  _leak_note="$_leak_note
  shapes :$(printf '%s' "$_leak_which" | cut -c1-300)"
fi

if [ "$_force_intent" = "1" ]; then
  if [ "$_block" = "0" ]; then
    _block=1
    _outcome="push-force-intent-blocked"
    _reason="the push argv carries an explicit force form (--force / -f / --force-with-lease / +refspec)"
  else
    _reason="$_reason; plus an explicit force form in the push argv"
  fi
fi

if [ "$_refs" = "0" ]; then
  _outcome="push-no-refs"
  _reason="no refs on stdin (invoked by hand, or an empty push)"
elif [ "$_block" = "0" ] && [ "$_deleted" = "$_refs" ]; then
  _outcome="push-delete"
fi

if [ "$_block" = "1" ]; then
  _override=0
  _ov_name="MIMIR_ALLOW_FORCE_PUSH=1"
  case "$_outcome" in
    push-path-leak-blocked*)
      _ov_name="MIMIR_ALLOW_PATH_LEAK=1"
      [ "${MIMIR_ALLOW_PATH_LEAK:-0}" = "1" ] && _override=1
      ;;
    *)
      [ "${MIMIR_ALLOW_FORCE_PUSH:-0}" = "1" ] && _override=1
      ;;
  esac
  if [ "$_override" = "1" ]; then
    printf 'pre-push: WARNING -- %s (override traced, %s)\n' "$_reason" "$_ov_name" >&2
    _outcome="${_outcome}-override"
    _block=0
  fi
fi

_dir=$(dirname "$TRACE_LOG" 2>/dev/null)
[ -n "$_dir" ] && mkdir -p "$_dir" 2>/dev/null
printf '{"ts":"%s","agent_id":"%s","trace_id":"%s","action":"push","outcome":"%s","override":"%s","repo":"%s","branch":"%s","remote":"%s","remote_url":"%s","refs":%s,"detail":"%s","pid":%s}\n' \
  "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$AGENT_ID" "$TRACE_ID" "$_outcome" \
  "$([ "$_block" = "0" ] && printf false || printf true)" \
  "$_repo" "$_branch" "$_remote" "$_url" "$_refs" "$_reason" "$$" >> "$TRACE_LOG" 2>/dev/null

if [ "$_block" = "1" ]; then
  printf '\n' >&2
  printf 'pre-push: BLOCKED -- immutable evidence (A6)\n' >&2
  printf '  reason : %s\n' "$_reason" >&2
  [ -n "${_leak_note:-}" ] && printf '%s\n' "$_leak_note" >&2
  printf '  rule   : pushed history is evidence; a rewrite erases attribution\n' >&2
  printf '           (docs/AGENT_REPO_OWNERSHIP.md sections 3 and 8, four-party ruling Q4)\n' >&2
  case "$_outcome" in
    push-path-leak-blocked*)
      printf '  instead: replace the value with a placeholder (or read it from the\n' >&2
      printf '           environment) and push that. Every pattern is a SHAPE --\n' >&2
      printf '           oc_/ou_ + 32 hex, sk- + 32+ alnum -- never a bare prefix,\n' >&2
      printf '           because a gate that fails on ordinary work gets switched off.\n' >&2
      printf '           If publishing the value is truly intended, export\n' >&2
      printf '           MIMIR_ALLOW_PATH_LEAK=1 (traced as an override)\n\n' >&2
      ;;
    *)
      printf '  instead: make a new commit and push it forward; if the rewrite is truly\n' >&2
      printf '           required, export MIMIR_ALLOW_FORCE_PUSH=1 (traced as an override)\n\n' >&2
      ;;
  esac
  exit 1
fi

exit 0
